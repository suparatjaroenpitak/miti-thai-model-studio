<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist\**</DefaultItemExcludes>
    <AssemblyName>MitiStudio</AssemblyName>
    <RootNamespace>ThaiModelStudio</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.11.0</Version>
    <Product>มิติ ZBrush ไทย</Product>
    <Description>แผงควบคุม ZBrush ภาษาไทยผ่าน Maxon Python API</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Controls\Theme.cs" />
    <Compile Include="ZBrushStudioForm.cs" />
    <Compile Include="Services\ZBrushCommandCatalog.cs" />
    <Compile Include="Services\ZBrushOnlyService.cs" />
    <None Include="zbrush\runner.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\ZBrush-Thai.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
